{
  "top_name": "uart_fifo_tx",
  "modules": [
    {
      "name": "sync_fifo_16x8",
      "behavior": "Synchronous 16-entry, 8-bit FIFO. Accept an input transfer when in_valid and in_ready are high; present the oldest stored byte on out_data with out_valid high. Hold the head byte and out_valid stable while out_ready is low. in_ready is low when full. The minimum accepted-input-to-visible-output age is one clock cycle. Reset clears the pointers and occupancy.",
      "ports": [
        {"name": "clk", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "rst", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "in_valid", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
        {"name": "in_ready", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
        {"name": "in_data", "direction": "input", "width": 8, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
        {"name": "out_valid", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
        {"name": "out_ready", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
        {"name": "out_data", "direction": "output", "width": 8, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"}
      ],
      "latency": 1,
      "compare_mode": "scoreboard",
      "reset": {"signal": "rst", "kind": "sync", "active_high": true, "duration_cycles": 5},
      "clock_domains": ["clk"],
      "parameters": {},
      "examples": [
        {
          "inputs": {"rst": 0, "in_valid": 0, "in_data": 0, "out_ready": 0},
          "expected": {"in_ready": 1, "out_valid": 0, "out_data": 0},
          "after_cycles": 1
        },
        {
          "inputs": {"rst": 0, "in_valid": 1, "in_data": 165, "out_ready": 0},
          "expected": {"in_ready": 1, "out_valid": 1, "out_data": 165},
          "after_cycles": 1
        },
        {
          "inputs": {"rst": 0, "in_valid": 1, "in_data": 60, "out_ready": 0},
          "expected": {"in_ready": 1, "out_valid": 1, "out_data": 60},
          "after_cycles": 3
        }
      ]
    },
    {
      "name": "uart_tx_8n1",
      "behavior": "Accept one byte when in_valid and tx_ready are high; tx_ready is high only while idle. On acceptance, drive the registered tx output low for one start bit, then transmit the byte least-significant bit first, followed by one high stop bit. Each start, data, and stop bit lasts exactly DIV clock cycles. Return tx high while idle. Reset synchronously returns the transmitter to idle with tx high. The accepted byte's start bit appears after one clock cycle.",
      "ports": [
        {"name": "clk", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "rst", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "in_valid", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
        {"name": "tx_ready", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
        {"name": "in_data", "direction": "input", "width": 8, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
        {"name": "tx", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"}
      ],
      "latency": 1,
      "compare_mode": "fixed_latency",
      "reset": {"signal": "rst", "kind": "sync", "active_high": true, "duration_cycles": 5},
      "clock_domains": ["clk"],
      "parameters": {"DIV": 868},
      "examples": [
        {
          "inputs": {"rst": 0, "in_valid": 0, "in_data": 0},
          "expected": {"tx": 1},
          "after_cycles": 1
        },
        {
          "inputs": {"rst": 0, "in_valid": 1, "in_data": 1},
          "expected": {"tx": 0},
          "after_cycles": 1
        },
        {
          "inputs": {"rst": 0, "in_valid": 1, "in_data": 1},
          "expected": {"tx": 1},
          "after_cycles": 869
        }
      ]
    }
  ],
  "connections": [
    {"src_module": "sync_fifo_16x8", "src_port": "out_valid", "dst_module": "uart_tx_8n1", "dst_port": "in_valid"},
    {"src_module": "uart_tx_8n1", "src_port": "tx_ready", "dst_module": "sync_fifo_16x8", "dst_port": "out_ready"},
    {"src_module": "sync_fifo_16x8", "src_port": "out_data", "dst_module": "uart_tx_8n1", "dst_port": "in_data"}
  ],
  "external_ports": [
    {"name": "clk", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
    {"name": "rst", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
    {"name": "in_valid", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
    {"name": "in_ready", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
    {"name": "in_data", "direction": "input", "width": 8, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "valid_ready"},
    {"name": "tx", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"}
  ]
}