{
  "top_name": "uart_fifo",
  "modules": [
    {
      "name": "sync_byte_fifo",
      "behavior": "Synchronous depth-8 FIFO with first-word-fall-through output. On each rising edge with rst low, it accepts in_data when in_valid and in_ready are high, and removes the oldest byte when out_valid and out_ready are high. in_ready reflects registered occupancy and is high exactly when fewer than eight bytes are waiting; out_valid reflects whether the FIFO is nonempty, and out_data is the oldest byte. A byte accepted into an empty FIFO becomes visible after that edge and can be accepted by uart_tx on the following edge. At full occupancy, a simultaneous output removal does not enable an input acceptance on that edge. A rising edge with rst high discards all queued bytes and accepts nothing; afterward in_ready is high, out_valid is low, and out_data is zero.",
      "ports": [
        {"name": "clk", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "rst", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "in_data", "direction": "input", "width": 8, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "in_valid", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "in_ready", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "out_data", "direction": "output", "width": 8, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "out_valid", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "out_ready", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"}
      ],
      "latency": 0,
      "compare_mode": "fixed_latency",
      "reset": {"signal": "rst", "kind": "sync", "active_high": true, "duration_cycles": 5},
      "clock_domains": ["clk"],
      "parameters": {"DEPTH": 8},
      "examples": [
        {
          "inputs": {"rst": 0, "in_data": 0, "in_valid": 0, "out_ready": 0},
          "expected": {"in_ready": 1, "out_data": 0, "out_valid": 0},
          "after_cycles": 1
        },
        {
          "inputs": {"rst": 0, "in_data": 42, "in_valid": 1, "out_ready": 0},
          "expected": {"in_ready": 1, "out_data": 42, "out_valid": 1},
          "after_cycles": 1
        }
      ]
    },
    {
      "name": "uart_tx",
      "behavior": "Parameterized 8N1 UART transmitter with registered tx and tx_ready outputs. For every CLKS_PER_BIT value P from 2 through 255, a byte is accepted on a rising edge when rst is low and tx_valid and tx_ready are high. Its start bit appears just after that edge, followed by the eight sampled data bits least-significant bit first and a stop bit, each lasting exactly P clocks. The frame lasts 10*P clocks. tx_ready is high while idle and during the final clock cycle of the stop bit, allowing a new byte to be accepted at the edge immediately after the preceding frame ends with no idle cycle. If no byte is accepted then, tx returns to idle high. tx and tx_ready depend only on registered state. A rising edge with rst high abandons any frame, accepts nothing, and sets tx high and tx_ready high.",
      "ports": [
        {"name": "clk", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "rst", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "tx_data", "direction": "input", "width": 8, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "tx_valid", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "tx_ready", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
        {"name": "tx", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"}
      ],
      "latency": 0,
      "compare_mode": "fixed_latency",
      "reset": {"signal": "rst", "kind": "sync", "active_high": true, "duration_cycles": 5},
      "clock_domains": ["clk"],
      "parameters": {"CLKS_PER_BIT": 16},
      "examples": [
        {
          "inputs": {"rst": 0, "tx_data": 0, "tx_valid": 0},
          "expected": {"tx_ready": 1, "tx": 1},
          "after_cycles": 1
        },
        {
          "inputs": {"rst": 0, "tx_data": 3, "tx_valid": 1},
          "expected": {"tx_ready": 0, "tx": 0},
          "after_cycles": 1
        }
      ]
    }
  ],
  "connections": [
    {"src_module": "sync_byte_fifo", "src_port": "out_data", "dst_module": "uart_tx", "dst_port": "tx_data"},
    {"src_module": "sync_byte_fifo", "src_port": "out_valid", "dst_module": "uart_tx", "dst_port": "tx_valid"},
    {"src_module": "uart_tx", "src_port": "tx_ready", "dst_module": "sync_byte_fifo", "dst_port": "out_ready"}
  ],
  "external_ports": [
    {"name": "clk", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
    {"name": "rst", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
    {"name": "in_data", "direction": "input", "width": 8, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
    {"name": "in_valid", "direction": "input", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
    {"name": "in_ready", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"},
    {"name": "tx", "direction": "output", "width": 1, "signed": false, "packed_dimensions": null, "clock_domain": "clk", "protocol": "none"}
  ]
}