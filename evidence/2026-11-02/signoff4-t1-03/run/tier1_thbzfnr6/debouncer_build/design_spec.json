{
  "top_name": "debouncer_top",
  "modules": [
    {
      "name": "debouncer",
      "behavior": "Synchronously reset with active-high rst; clean is 0 during reset. After reset, track consecutive clock samples of noisy: when noisy differs from the current candidate value, begin a new run at that sample; when it matches, extend the run. Update clean to the candidate value on the eighth consecutive sample, and otherwise hold clean at its previous value. A sample equal to clean does not change clean.",
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1,
          "signed": false,
          "packed_dimensions": null,
          "clock_domain": "clk",
          "protocol": "none"
        },
        {
          "name": "rst",
          "direction": "input",
          "width": 1,
          "signed": false,
          "packed_dimensions": null,
          "clock_domain": "clk",
          "protocol": "none"
        },
        {
          "name": "noisy",
          "direction": "input",
          "width": 1,
          "signed": false,
          "packed_dimensions": null,
          "clock_domain": "clk",
          "protocol": "none"
        },
        {
          "name": "clean",
          "direction": "output",
          "width": 1,
          "signed": false,
          "packed_dimensions": null,
          "clock_domain": "clk",
          "protocol": "none"
        }
      ],
      "latency": 0,
      "compare_mode": "fixed_latency",
      "reset": {
        "signal": "rst",
        "kind": "sync",
        "active_high": true,
        "duration_cycles": 5
      },
      "clock_domains": [
        "clk"
      ],
      "parameters": {},
      "examples": [
        {
          "inputs": {
            "rst": 0,
            "noisy": 1
          },
          "expected": {
            "clean": 0
          },
          "after_cycles": 7
        },
        {
          "inputs": {
            "rst": 0,
            "noisy": 1
          },
          "expected": {
            "clean": 1
          },
          "after_cycles": 8
        },
        {
          "inputs": {
            "rst": 0,
            "noisy": 0
          },
          "expected": {
            "clean": 0
          },
          "after_cycles": 8
        }
      ]
    }
  ],
  "connections": [],
  "external_ports": [
    {
      "name": "clk",
      "direction": "input",
      "width": 1,
      "signed": false,
      "packed_dimensions": null,
      "clock_domain": "clk",
      "protocol": "none"
    },
    {
      "name": "rst",
      "direction": "input",
      "width": 1,
      "signed": false,
      "packed_dimensions": null,
      "clock_domain": "clk",
      "protocol": "none"
    },
    {
      "name": "noisy",
      "direction": "input",
      "width": 1,
      "signed": false,
      "packed_dimensions": null,
      "clock_domain": "clk",
      "protocol": "none"
    },
    {
      "name": "clean",
      "direction": "output",
      "width": 1,
      "signed": false,
      "packed_dimensions": null,
      "clock_domain": "clk",
      "protocol": "none"
    }
  ]
}