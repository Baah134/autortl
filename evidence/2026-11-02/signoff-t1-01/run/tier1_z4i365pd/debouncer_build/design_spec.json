{
  "top_name": "debouncer_top",
  "modules": [
    {
      "name": "debouncer",
      "behavior": "Synchronous active-high reset clears clean and the stability counter. After reset, clean is 0. On each clock edge, noisy is compared with the previously sampled noisy value. A change starts a new run of one matching sample; each subsequent matching sample advances the run. When noisy has matched for 8 consecutive clock cycles, clean takes its value. Until then, clean holds its previous value. The first sample of a new value counts as cycle 1; clean updates on the 8th matching sample.",
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1,
          "signed": false,
          "packed_dimensions": null,
          "clock_domain": "clk",
          "protocol": "none"
        },
        {
          "name": "rst",
          "direction": "input",
          "width": 1,
          "signed": false,
          "packed_dimensions": null,
          "clock_domain": "clk",
          "protocol": "none"
        },
        {
          "name": "noisy",
          "direction": "input",
          "width": 1,
          "signed": false,
          "packed_dimensions": null,
          "clock_domain": "clk",
          "protocol": "none"
        },
        {
          "name": "clean",
          "direction": "output",
          "width": 1,
          "signed": false,
          "packed_dimensions": null,
          "clock_domain": "clk",
          "protocol": "none"
        }
      ],
      "latency": 0,
      "compare_mode": "fixed_latency",
      "reset": {
        "signal": "rst",
        "kind": "sync",
        "active_high": true,
        "duration_cycles": 5
      },
      "clock_domains": [
        "clk"
      ],
      "parameters": {},
      "examples": [
        {
          "inputs": {
            "noisy": 1
          },
          "expected": {
            "clean": 0
          },
          "after_cycles": 7
        },
        {
          "inputs": {
            "noisy": 1
          },
          "expected": {
            "clean": 1
          },
          "after_cycles": 8
        },
        {
          "inputs": {
            "noisy": 0
          },
          "expected": {
            "clean": 0
          },
          "after_cycles": 8
        }
      ]
    }
  ],
  "connections": [],
  "external_ports": [
    {
      "name": "clk",
      "direction": "input",
      "width": 1,
      "signed": false,
      "packed_dimensions": null,
      "clock_domain": "clk",
      "protocol": "none"
    },
    {
      "name": "rst",
      "direction": "input",
      "width": 1,
      "signed": false,
      "packed_dimensions": null,
      "clock_domain": "clk",
      "protocol": "none"
    },
    {
      "name": "noisy",
      "direction": "input",
      "width": 1,
      "signed": false,
      "packed_dimensions": null,
      "clock_domain": "clk",
      "protocol": "none"
    },
    {
      "name": "clean",
      "direction": "output",
      "width": 1,
      "signed": false,
      "packed_dimensions": null,
      "clock_domain": "clk",
      "protocol": "none"
    }
  ]
}