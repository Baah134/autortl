      "mutation_note": null,
      "mutation_targets": [
        {
          "original": "`timescale 1ns/1ps\n// @latency 1\n// Qualification only. Never configured as a generator seed.\nmodule packet_fifo_core #(parameter WIDTH=8, parameter DEPTH=3)(\n    input clk, input rst, input [WIDTH-1:0] in_data, input in_last,\n    input in_valid, output in_ready, output [WIDTH-1:0] out_data,\n    output out_last, output out_valid, input out_ready);\n    // clog2(DEPTH+1) remains positive for DEPTH=1; explicit wrap handles all depths.\n    reg [$clog2(DEPTH+1)-1:0] read_pointer, write_pointer;\n    reg [$clog2(DEPTH+1)-1:0] used;\n    reg [WIDTH:0] memory [0:DEPTH-1];\n    wire push = in_valid && in_ready;\n    wire pop = out_valid && out_ready;\n    assign in_ready = (used < DEPTH) || out_ready;\n    assign out_valid = (used != 0);\n    assign out_data = memory[read_pointer][WIDTH-1:0];\n    assign out_last = memory[read_pointer][WIDTH];\n    always @(posedge clk) begin\n        if(rst) begin\n            read_pointer <= 0;\n            write_pointer <= 0;\n            used <= 0;\n        end else begin\n            if(push) begin\n                memory[write_pointer] <= {in_last,in_data};\n                if(write_pointer == DEPTH-1) write_pointer <= 0;\n                else write_pointer <= write_pointer + 1'b1;\n            end\n            if(pop) begin\n                if(read_pointer == DEPTH-1) read_pointer <= 0;\n                else read_pointer <= read_pointer + 1'b1;\n            end\n            case({push,pop})\n                2'b10: used <= used + 1'b1;\n                2'b01: used <= used - 1'b1;\n                2'b11: used <= used;\n                default: used <= used;\n            endcase\n        end\n    end\nendmodule\n",
          "replacement": "`timescale 1ns/1ps\n// @latency 1\n// Intentionally false annotation: temporal assertions must establish behavior.\nmodule packet_fifo_core #(parameter WIDTH=8, parameter DEPTH=3)(\n    input clk, input rst, input [WIDTH-1:0] in_data, input in_last,\n    input in_valid, output in_ready, output [WIDTH-1:0] out_data,\n    output out_last, output out_valid, input out_ready);\n    assign in_ready = out_ready && !rst;\n    assign out_valid = in_valid && !rst;\n    assign out_data = in_data;\n    assign out_last = in_last;\nendmodule\n",
          "original_occurrences": 1
        }
