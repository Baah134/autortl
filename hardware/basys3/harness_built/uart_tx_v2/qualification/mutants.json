[
  {"name": "full_length_stop", "why": "the v1 behavior: stop bit lasts DIV cycles, so line-rate input overflows",
   "find": "wire [CW-1:0] last = (bitn == 4'd9) ? STOP - 1 : DIV - 1;", "replace": "wire [CW-1:0] last = DIV - 1;"},
  {"name": "stop_one_cycle_short", "why": "stop bit lasts STOP-1 cycles",
   "find": "wire [CW-1:0] last = (bitn == 4'd9) ? STOP - 1 : DIV - 1;", "replace": "wire [CW-1:0] last = (bitn == 4'd9) ? STOP - 2 : DIV - 1;"},
  {"name": "short_data_bits", "why": "every bit, not only the stop bit, is shortened",
   "find": "wire [CW-1:0] last = (bitn == 4'd9) ? STOP - 1 : DIV - 1;", "replace": "wire [CW-1:0] last = STOP - 1;"},
  {"name": "msb_first", "why": "data bits sent most significant first",
   "find": "frame    <= {1'b1, in_data, 1'b0};",
   "replace": "frame    <= {1'b1, in_data[0], in_data[1], in_data[2], in_data[3], in_data[4], in_data[5], in_data[6], in_data[7], 1'b0};"},
  {"name": "no_stop_bit", "why": "returns to idle after the last data bit",
   "find": "if (bitn == 4'd9) begin", "replace": "if (bitn == 4'd8) begin"},
  {"name": "inverted_start", "why": "start bit sent as 1",
   "find": "                tx       <= 1'b0;", "replace": "                tx       <= 1'b1;"},
  {"name": "live_data", "why": "uses in_data at each bit instead of the captured byte",
   "find": "tx   <= frame[bitn + 4'd1];", "replace": "tx   <= (bitn == 4'd8) ? 1'b1 : in_data[bitn];"},
  {"name": "reset_ignored_while_busy", "why": "rst only works when idle",
   "find": "        if (rst) begin", "replace": "        if (rst && in_ready) begin"},
  {"name": "accept_ignores_valid", "why": "starts a frame without in_valid",
   "find": "            if (in_valid) begin", "replace": "            if (1'b1) begin"},
  {"name": "ready_stuck_high", "why": "in_ready reported high while busy",
   "find": "                in_ready <= 1'b0;", "replace": "                in_ready <= 1'b1;"},
  {"name": "reset_line_low", "why": "tx idles low after reset",
   "find": "            tx       <= 1'b1;\n            tick     <= 0;", "replace": "            tx       <= 1'b0;\n            tick     <= 0;"}
]
